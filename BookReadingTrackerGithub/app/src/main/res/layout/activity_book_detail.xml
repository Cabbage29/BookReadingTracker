<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:backgroundTint="#2E74B5"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Title"
            android:textSize="22sp"
            android:textColor="#1F3864"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvBookAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Author: "
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Difficulty: "
            android:textSize="14sp"
            android:textColor="#2E74B5"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvReadingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated Reading Time: "
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnAddToLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD TO READING LOG"
            android:backgroundTint="#1F3864"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnViewSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW DAILY SUMMARY"
            android:backgroundTint="#2E74B5"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>
