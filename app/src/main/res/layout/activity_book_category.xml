<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:backgroundTint="#2E74B5"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Book Categories"
            android:textSize="20sp"
            android:textColor="#1F3864"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnFiction"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="📖  Fiction"
        android:textSize="20sp"
        android:backgroundTint="#1F3864"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnNonFiction"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="📰  Non-Fiction"
        android:textSize="20sp"
        android:backgroundTint="#2E74B5"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnComics"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="🎨  Comics and Manga"
        android:textSize="20sp"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>
